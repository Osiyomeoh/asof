# Copy to .env.local and fill. .env* is gitignored.

# Tavily — live web verification (https://app.tavily.com)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Provider key that Bifrost routes to (Google Gemini via Google AI Studio)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# Bifrost gateway base URL (OpenAI-compatible). Local default below.
BIFROST_BASE_URL=http://localhost:8088/v1
# Model in Bifrost's provider/model form
ASOF_MODEL=gemini/gemini-flash-lite-latest

# Local encryption key for Bifrost's key store (any 32+ char string; not a real secret for the demo)
BIFROST_ENCRYPTION_KEY=change-me-to-any-32-char-random-string

# Set to "1" to force sample mode (no keys needed)
ASOF_SAMPLE_ONLY=0
